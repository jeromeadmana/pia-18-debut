# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Neon: `neon link --project-id <id> --branch <branch>` writes the first three
# automatically. You should not need to set them by hand.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Admin dashboard (/admin).
# ADMIN_SESSION_SECRET signs the session cookie and must be >= 32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_PASSWORD is the single operator password.
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# Cloudinary. Leave both blank to serve gallery images from /public/gallery.
#
# CLOUDINARY_URL is server-only and carries the api key + secret:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# It is read by scripts/upload-gallery.ts and never reaches the browser.
CLOUDINARY_URL=
#
# The cloud name on its own is PUBLIC - it appears in every delivery URL - so it
# is exposed separately rather than shipping the secret to the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
#
# NOTE: this Cloudinary account is shared with other projects. Everything this
# app writes is confined to the `pia-18-debut/` folder, enforced in
# lib/cloudinary.ts. There is no delete path in this codebase on purpose.
