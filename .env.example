# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Neon: `neon link --project-id <id> --branch <branch>` writes the first three
# automatically. You should not need to set them by hand.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Admin dashboard (/admin).
# ADMIN_SESSION_SECRET signs the session cookie and must be >= 32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_PASSWORD is the single operator password.
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# Cloudinary. Leave blank to serve gallery images from /public/gallery instead.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
